POSTGRES_PASSWORD = mysecretpassword
POSTGRES_UI_PASSWORD = mysecretapppassword
POSTGRES_IDENTITY_PASSWORD = mysecretidentitypassword
POSTGRES_TENANT_PASSWORD = mysecrettenantpassword
POSTGRES_ADMIN_PASSWORD = mysecretadminpassword

VALKEY_PASSWORD = your-secure-valkey-password

BETTER_AUTH_SECRET = your-secure-better-auth-secret
OPENBAO_ROOT_TOKEN = generated-by-bao-operator-init
OPENBAO_UNSEAL_KEY = generated-by-bao-operator-init
CPLANE_SERVICE_TOKEN = replace-with-a-long-random-service-token
CLOUDFLARE_TUNNEL_TOKEN="cloudflare_tunnel_token_placeholder"

# Global organization registry
REGISTRY_HOST=localhost:5000
REGISTRY_INTERNAL_URL=http://registry:5000
REGISTRY_TOKEN_REALM=http://localhost:8080/api/registry/token
REGISTRY_TOKEN_ISSUER=cplane-registry
# Distribution recommends at least 60 seconds for client compatibility.
REGISTRY_TOKEN_TTL_SECONDS=60
REGISTRY_HTTP_SECRET=replace-with-a-long-random-registry-secret
REGISTRY_STORAGE_S3_REGION=us-east-1
REGISTRY_STORAGE_S3_BUCKET=cplane-registry
# Filled by install.sh after configuring the first S3 provider.
REGISTRY_STORAGE_S3_PROVIDER_ID=
# Filled by install.sh with the provider's backing bucket.
# REGISTRY_STORAGE_S3_PHYSICAL_BUCKET=cplane-registry
# Generated by install.sh. These authenticate Distribution to the Storage API;
# the provider credentials are stored separately in OpenBao.
REGISTRY_STORAGE_S3_ACCESSKEY=replace-with-s3-access-key-id
REGISTRY_STORAGE_S3_SECRETKEY=replace-with-s3-secret-access-key
# Dedicated credentials used only by Registry garbage-collection workers.
REGISTRY_STORAGE_S3_GC_ACCESSKEY=replace-with-gc-s3-access-key-id
REGISTRY_STORAGE_S3_GC_SECRETKEY=replace-with-gc-s3-secret-access-key
