ARG RUST_VERSION=1.92.0
ARG DIOXUS_VERSION=0.7.9

FROM rust:${RUST_VERSION} AS tools
ARG DIOXUS_VERSION
RUN rustup target add wasm32-unknown-unknown && cargo install dioxus-cli --version ${DIOXUS_VERSION} --locked
WORKDIR /usr/src/app

FROM tools AS builder
COPY Cargo.toml Cargo.lock ./
COPY packages/c-plane/Cargo.toml ./packages/c-plane/Cargo.toml
COPY packages/c-plane/src/main.rs ./packages/c-plane/src/main.rs
COPY packages/control-plane ./packages/control-plane
WORKDIR /usr/src/app/packages/control-plane
RUN dx build --web --fullstack true --release

FROM debian:bookworm-slim AS production
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /usr/src/app/target/dx/control-plane/release/web/ ./
ENV IP=0.0.0.0 PORT=3001
EXPOSE 3001
ENTRYPOINT ["/app/server"]
