ARG PACKAGE=ui

FROM denoland/deno:2.9.3 AS base
ARG PACKAGE
WORKDIR /usr/src/app

COPY package.json ./package.json
COPY deno.lock ./deno.lock
COPY packages/ui-shared/package.json ./packages/ui-shared/package.json
COPY packages/ui/package.json ./packages/ui/package.json
COPY packages/sdk/package.json ./packages/sdk/package.json

RUN deno ci

COPY packages/ui-shared/schema ./packages/ui-shared/schema
COPY packages/ui-shared/types ./packages/ui-shared/types
COPY packages/ui-shared/utils ./packages/ui-shared/utils
COPY packages/sdk ./packages/sdk
COPY packages/${PACKAGE} ./packages/${PACKAGE}

WORKDIR /usr/src/app/packages/${PACKAGE}

FROM base AS development
ENV CHOKIDAR_USEPOLLING=true
ENV CHOKIDAR_INTERVAL=250
ENV WATCHPACK_POLLING=true
CMD ["deno", "task", "dev"]

FROM base AS migration
CMD ["deno", "task", "migrate"]

FROM base AS production-prepack
RUN deno task build

FROM production-prepack AS production-compile
RUN mkdir /app && deno compile --no-check --allow-env --allow-net --allow-read --output /app/cplane-ui .output/server/index.mjs

FROM gcr.io/distroless/cc-debian12:nonroot AS production
WORKDIR /app
COPY --from=production-compile /app/cplane-ui ./cplane-ui
# Nitro resolves the compiled entry's sibling public directory as /tmp/public.
COPY --from=production-prepack /usr/src/app/packages/ui/.output/public /tmp/public
CMD ["./cplane-ui"]
