<clickhouse>
    <storage_configuration>
        <disks>
            <clickhouse_s3>
                <type>s3</type>
                <endpoint from_env="CLICKHOUSE_S3_ENDPOINT" />
                <access_key_id from_env="CLICKHOUSE_STORAGE_ACCESS_KEY_ID" />
                <secret_access_key from_env="CLICKHOUSE_STORAGE_SECRET_ACCESS_KEY" />
                <metadata_path>/var/lib/clickhouse/disks/clickhouse_s3/</metadata_path>
            </clickhouse_s3>
            <clickhouse_cache>
                <type>cache</type>
                <disk>clickhouse_s3</disk>
                <path>/var/lib/clickhouse/disks/clickhouse_cache/</path>
                <max_size>10Gi</max_size>
            </clickhouse_cache>
        </disks>
        <policies>
            <clickhouse>
                <volumes>
                    <main>
                        <disk>clickhouse_cache</disk>
                    </main>
                </volumes>
            </clickhouse>
        </policies>
    </storage_configuration>
    <merge_tree>
        <storage_policy>clickhouse</storage_policy>
    </merge_tree>
</clickhouse>
