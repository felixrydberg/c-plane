{
  "name": "@cplane/ui-shared",
  "private": true,
  "type": "module",
  "types": "./schema/index.ts",
  "exports": {
    "./schema": {
      "types": "./schema/index.ts",
      "default": "./schema/index.ts"
    },
    "./types": {
      "types": "./types/index.ts",
      "default": "./types/index.ts"
    },
    "./utils": {
      "types": "./utils/index.ts",
      "default": "./utils/index.ts"
    }
  },
  "scripts": {
    "migrate:generate": "bunx drizzle-kit generate --config=drizzle.config.ts",
    "migrate": "bunx drizzle-kit migrate --config=drizzle.config.ts",
    "migrate:push": "bunx drizzle-kit push --config=drizzle.config.ts",
    "better-auth:generate:ui": "bunx @better-auth/cli generate --config ../ui/server/utils/auth.ts --y --output ./schema/better-auth/studio.ts",
    "better-auth:generate:ui-studio": "bunx @better-auth/cli generate --config ../ui-studio/server/utils/auth.ts --y --output ./schema/better-auth/ui-studio.ts",
    "better-auth:generate": "bun run better-auth:generate:ui; bun run better-auth:generate:ui-studio"
  },
  "peerDependencies": {
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "drizzle-kit": "0.31.9",
    "drizzle-orm": "^0.45.1"
  }
}
