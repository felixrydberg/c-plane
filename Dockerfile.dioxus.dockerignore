# This image builds only the private Rust control plane. Keep the build context
# independent from the Nuxt apps, local dependencies, and other service code.
**
!Cargo.toml
!Cargo.lock
!packages
!packages/api
!packages/api/Cargo.toml
!packages/api/src
!packages/api/src/main.rs
!packages/ingress
!packages/ingress/**
!packages/storage
!packages/storage/**
!packages/worker
!packages/worker/**
!packages/control-plane
!packages/control-plane/**
!packages/lib
!packages/lib/**
